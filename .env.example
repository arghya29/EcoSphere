# --- Database (Neon Postgres) ---
# Get this from your Neon project dashboard. Use the pooled connection
# string for serverless/Vercel deployments.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Set to your deployed URL in production (e.g. https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
# Leave blank to disable Google sign-in; Credentials login still works.
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
